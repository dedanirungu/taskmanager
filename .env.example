# Copy to .env and fill in. The platform's docker-compose reads from this file.

# ---------- Postgres (the compose file boots a db container; values below are used by both) ----------
PGDATABASE=devplatform
PGUSER=devplatform
PGPASSWORD=please-change-me

# ---------- Web session ----------
# Generate with:   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-48-random-bytes-base64url

# ---------- GitHub ----------
# Fine-grained PAT scoped to the 5 client repos, with permissions:
#   Contents: Read and write
#   Pull requests: Read and write
#   Metadata: Read
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_USER=your-github-username
GITHUB_EMAIL=you@example.com

# ---------- Telegram (optional but recommended) ----------
# Create a bot via @BotFather, send /start to it, then visit
#   https://api.telegram.org/bot<TOKEN>/getUpdates
# to find your chat_id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# ---------- Public domain ----------
# Used to construct workspace URLs (e.g. dev1.yourdomain.com).
PUBLIC_DOMAIN=yourdomain.com
