# Replace ${PUBLIC_DOMAIN} when rendering this file (envsubst or sed).
# Then symlink into /etc/nginx/conf.d/ on the host.

server {
    listen 80;
    server_name platform.${PUBLIC_DOMAIN};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name platform.${PUBLIC_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/platform.${PUBLIC_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/platform.${PUBLIC_DOMAIN}/privkey.pem;

    client_max_body_size 25m;

    location / {
        proxy_pass         http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   Upgrade           $http_upgrade;
        proxy_set_header   Connection        "upgrade";
        proxy_read_timeout 600s;
    }
}
